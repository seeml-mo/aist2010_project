extends RefCounted
## Loads the chart-only JSON (version 2).
##
## The chart is intentionally independent from the level: it only contains
## audio metadata, timing and notes. Terrain/enemies are generated by Godot.

const LANES := ["attack", "defend", "jump"]

static func load_chart(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {"ok": false, "error": "Chart not found: " + path, "chart": {}}

	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		return {"ok": false, "error": "Empty chart file: " + path, "chart": {}}

	var parsed = JSON.parse_string(text)
	if not parsed is Dictionary:
		return {"ok": false, "error": "Invalid JSON: " + path, "chart": {}}

	var data: Dictionary = parsed
	if int(data.get("version", -1)) != 2:
		return {"ok": false, "error": "Unsupported chart version", "chart": {}}

	var audio = data.get("audio")
	if not audio is Dictionary or str(audio.get("stream", "")).is_empty():
		return {"ok": false, "error": "chart.audio.stream is missing", "chart": {}}

	var chart = data.get("chart")
	if not chart is Dictionary or not chart.get("notes") is Array:
		return {"ok": false, "error": "chart.notes is missing", "chart": {}}

	var lanes = chart.get("lanes", LANES)
	if not lanes is Array:
		return {"ok": false, "error": "Invalid chart.lanes", "chart": {}}
	var clean_notes: Array = []
	for raw in chart.notes:
		if not raw is Dictionary or not raw.has("time") or not raw.has("lane"):
			continue

		var note_time := float(raw.time)
		var lane := int(raw.lane)
		if note_time < 0.0 or lane < 0 or lane >= lanes.size():
			continue

		var canonical_lane := LANES.find(lanes[lane])
		if canonical_lane == -1:
			continue
		var note := {"time": note_time, "lane": canonical_lane}
		if canonical_lane != 2 and raw.has("duration"):
			var hold_time := float(raw.duration)
			if hold_time <= 0.0:
				continue
			note["duration"] = hold_time
		clean_notes.append(note)

	clean_notes.sort_custom(func(a, b): return float(a.time) < float(b.time))
	if clean_notes.is_empty():
		return {"ok": false, "error": "Chart has no valid notes", "chart": {}}

	var timing = data.get("timing", {})
	if not timing is Dictionary:
		timing = {}

	var out_chart: Dictionary = chart.duplicate(true)
	out_chart["lanes"] = LANES.duplicate()
	out_chart["notes"] = clean_notes

	return {
		"ok": true,
		"error": "",
		"chart": {
			"version": 2,
			"audio": audio.duplicate(true),
			"timing": timing,
			"chart": out_chart,
		},
	}
